{
  "name": "koishi-plugin-mcfish",
  "version": "2.2.0",
  "description": "Minecraft 风格钓鱼小游戏：仓库、每日市场、铁匠铺和福布斯排行榜",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": ["lib", "src", "assets", "docs/economy.md", "tsconfig.json", "LICENSE", "NOTICE", "README.md"],
  "license": "AGPL-3.0-only",
  "author": "Huanghun542",
  "repository": { "type": "git", "url": "https://github.com/Huanghun542/koishi-plugin-mcfish.git" },
  "homepage": "https://github.com/Huanghun542/koishi-plugin-mcfish#readme",
  "bugs": { "url": "https://github.com/Huanghun542/koishi-plugin-mcfish/issues" },
  "keywords": ["koishi", "plugin", "minecraft", "fishing", "钓鱼"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "prepack": "npm run build"
  },
  "peerDependencies": { "koishi": "^4.18.0", "koishi-plugin-puppeteer": "^3.9.0" },
  "peerDependenciesMeta": { "koishi-plugin-puppeteer": { "optional": true } },
  "devDependencies": {
    "koishi": "4.18.11",
    "@koishijs/plugin-database-sqlite": "4.7.0",
    "@koishijs/plugin-mock": "2.6.6",
    "koishi-plugin-puppeteer": "3.9.0",
    "typescript": "5.9.3",
    "@types/node": "^22.0.0"
  },
  "koishi": {
    "description": { "zh": "MC 钓鱼：仓库、每日市场、铁匠铺、附魔、维修和福布斯排行榜" },
    "service": { "required": ["database"], "optional": ["puppeteer"] },
    "locales": ["zh-CN"]
  }
